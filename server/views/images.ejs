<%- include('partials/header', { title: 'Imagens' }) %>

<h1>Imagens</h1>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (message) { %><div class="alert alert-success"><%= message %></div><% } %>

<div class="box">
    <h2>Enviar nova imagem</h2>
    <form id="uploadForm" enctype="multipart/form-data">
        <div class="form-row">
            <label>Arquivo JPEG, PNG ou WebP (máx. 20 MB)</label>
            <input type="file" id="imageInput" name="image" accept="image/jpeg,image/png,image/webp" required>
        </div>
        <button type="submit" id="uploadBtn" class="btn btn-primary">Enviar</button>
    </form>

    <div id="uploadProgress" style="display:none; margin-top:16px">
        <div style="display:flex; justify-content:space-between; margin-bottom:6px">
            <span id="uploadLabel" style="font-size:14px; color:#ccc">Enviando...</span>
            <span id="uploadPercent" style="font-size:14px; font-weight:bold; color:#fff">0%</span>
        </div>
        <div style="background:#333; border-radius:6px; height:14px; overflow:hidden">
            <div id="uploadBar" style="height:100%; width:0%; background:#4a9eff; border-radius:6px; transition:width 0.2s ease"></div>
        </div>
    </div>
</div>

<script>
document.getElementById('uploadForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const file = document.getElementById('imageInput').files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('image', file);

    const btn       = document.getElementById('uploadBtn');
    const progress  = document.getElementById('uploadProgress');
    const bar       = document.getElementById('uploadBar');
    const percent   = document.getElementById('uploadPercent');
    const label     = document.getElementById('uploadLabel');

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    progress.style.display = 'block';

    const xhr = new XMLHttpRequest();

    xhr.upload.addEventListener('progress', function(e) {
        if (!e.lengthComputable) return;
        const pct = Math.round((e.loaded / e.total) * 100);
        bar.style.width = pct + '%';
        percent.textContent = pct + '%';
        if (pct === 100) {
            label.textContent = 'Processando imagem...';
        }
    });

    xhr.addEventListener('load', function() {
        if (xhr.status >= 200 && xhr.status < 400) {
            window.location.href = xhr.responseURL || '/images?msg=Imagem+enviada+com+sucesso.';
        } else {
            bar.style.background = '#e05';
            label.textContent = 'Erro no envio.';
            percent.textContent = '';
            btn.disabled = false;
            btn.textContent = 'Enviar';
        }
    });

    xhr.addEventListener('error', function() {
        bar.style.background = '#e05';
        label.textContent = 'Falha na conexão.';
        percent.textContent = '';
        btn.disabled = false;
        btn.textContent = 'Enviar';
    });

    xhr.open('POST', '/images/upload');
    xhr.send(formData);
});
</script>

<div class="box">
    <h2>Imagens armazenadas (<%= images.length %>)</h2>
    <% if (images.length === 0) { %>
        <p style="color:#888">Nenhuma imagem enviada ainda.</p>
    <% } else { %>
    <table>
        <thead>
            <tr>
                <th></th>
                <th>Nome original</th>
                <th>Tamanho</th>
                <th>Duração</th>
                <th>Em playlists</th>
                <th>Enviado em</th>
                <th>Enviado por</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        <% images.forEach(i => { %>
            <tr>
                <td style="width:60px">
                    <img src="/media/<%= i.filename %>" style="width:56px;height:32px;object-fit:cover;border-radius:3px">
                </td>
                <td><%= i.original_name %></td>
                <td><%= (i.size / 1024 / 1024).toFixed(1) %> MB</td>
                <td>
                    <form action="/images/<%= i.id %>/duration" method="POST" style="display:flex;gap:6px;align-items:center">
                        <input type="number" name="duration_seconds" value="<%= i.duration_seconds %>" min="1" max="3600" style="width:64px">
                        <button type="submit" class="btn btn-primary btn-sm">Salvar</button>
                    </form>
                </td>
                <td><%= i.playlist_count %></td>
                <td><%= new Date(i.created_at).toLocaleString('pt-BR') %></td>
                <td><%= i.owner_name || '—' %></td>
                <td>
                    <form action="/images/<%= i.id %>/delete" method="POST"
                          onsubmit="return confirm('Remover esta imagem permanentemente?')">
                        <button type="submit" class="btn btn-danger btn-sm">Remover</button>
                    </form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</div>

<%- include('partials/footer') %>
